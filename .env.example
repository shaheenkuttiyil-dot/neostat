# --- Database ---
DATABASE_URL=sqlite:///./data/documents.db

# --- Document constraints ---
MAX_PAGES=3
MAX_FILE_SIZE_MB=15

# --- LLM provider used for extraction: Groq (OpenAI-compatible API) ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
LLM_MAX_RETRIES=3

# --- OCR (leave blank unless Tesseract is at a non-default path) ---
TESSERACT_CMD=

# --- Financial validation tolerance (absolute currency units) ---
VALIDATION_TOLERANCE=1.0

# --- Logging ---
LOG_LEVEL=INFO

# --- Uploads ---
UPLOAD_DIR=./data/uploads
